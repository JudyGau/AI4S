# ===== 符号回归数据集生成器 · LLM 多轮对话配置模板 =====
# 使用方法：复制为 .env（不要提交 .env，里面含密钥），generate.py 会自动读取。
#   cp .env.example .env      （Linux / macOS）
#   Copy-Item .env.example .env   （Windows PowerShell）
# 所有项均可留空再用 CLI 参数 --llm-* 覆盖。

# OpenAI 兼容 API 的 base_url（聊天补全端点在其后追加 /chat/completions）
# 示例：
#   DeepSeek:  https://api.deepseek.com          模型 deepseek-chat
#   通义:      https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
#   本地 vLLM: http://127.0.0.1:8000/v1         模型 见你的部署
LLM_BASE_URL=

# API 密钥（优先级：CLI --llm-api-key > OPENAI_API_KEY 环境变量）
OPENAI_API_KEY=

# 模型名
LLM_MODEL=

# ---- 可选（有合理默认，通常不用改）----
# 收敛循环最大轮数（默认 5，对应 --llm-max-rounds）
LLM_MAX_ROUNDS=

# 单次回答 token 上限（默认 1024，对应 --llm-max-tokens）。
# 注意：glm-flash 等“推理模型”会先把大量预算花在思考链上再输出正文，
# 1024 常被思考链吃完导致 content 为空、无法提取表达式；建议提到 4096（代价是更慢）。
LLM_MAX_TOKENS=

# 追加到请求体的 JSON（对应 --llm-extra-body），用于厂商专属字段：
#   - 智谱 glm-4.7 等"强制思考"模型：设 {"thinking":{"type":"disabled"}} 关闭思考，正文直出且快（实测关键开关）；
#   - 其它 GLM: {"thinking":{"type":"enabled","budget_tokens":256}} 或 {"reasoning_effort":"low"}（按模型文档）。
# 合法 JSON 字典会被解析并合并进每次请求；留空则不带任何额外字段。
LLM_EXTRA_BODY=

# LLM 多轮生成并发目标数（对应 --llm-max-workers，默认 1）。
# >1 用线程池并行多个目标，显著提吞吐，需 API 支持并发；实测 6 并发约 6× 提速。
LLM_MAX_WORKERS=

# LLM 链失败/未收敛/首轮即对时是否回退模板路径（1 回退 / 0 不回退，默认 1）
LLM_FALLBACK=